# PostgreSQL (docker-compose)
POSTGRES_USER=rosalind
POSTGRES_PASSWORD=rosalind
POSTGRES_DB=rosalind

# SeaweedFS S3-compatible object storage (shared by backend + CLI)
ROSALIND_S3_BUCKET=rosalind
ROSALIND_S3_ENDPOINT=http://localhost:8333
ROSALIND_S3_ACCESS_KEY=rosalind
ROSALIND_S3_SECRET_KEY=rosalind
ROSALIND_S3_REGION=us-east-1

# Backend database connection
ROSALIND_DATABASE_URL=postgresql+psycopg://rosalind:rosalind@localhost:5432/rosalind

# Google OAuth (Web application client)
ROSALIND_GOOGLE_CLIENT_ID=
ROSALIND_GOOGLE_CLIENT_SECRET=
ROSALIND_GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
ROSALIND_GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token
ROSALIND_GOOGLE_AUTH_URI=https://accounts.google.com/o/oauth2/auth

# Encryption key for stored OAuth tokens (generate with:
#   uv run --directory backend python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ROSALIND_TOKEN_ENCRYPTION_KEY=
