# PostgreSQL (docker-compose)
POSTGRES_USER=rosalind
POSTGRES_PASSWORD=rosalind
POSTGRES_DB=rosalind

# SeaweedFS S3-compatible object storage (shared by backend + CLI)
ROSALIND_S3_BUCKET=rosalind
ROSALIND_S3_ENDPOINT=http://localhost:8333
ROSALIND_S3_ACCESS_KEY=rosalind
ROSALIND_S3_SECRET_KEY=rosalind
ROSALIND_S3_REGION=us-east-1

# Backend database connection
ROSALIND_DATABASE_URL=postgresql+psycopg://rosalind:rosalind@localhost:5432/rosalind

# Google OAuth (Web application client)
ROSALIND_GOOGLE_CLIENT_ID=
ROSALIND_GOOGLE_CLIENT_SECRET=
ROSALIND_GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
ROSALIND_GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token
ROSALIND_GOOGLE_AUTH_URI=https://accounts.google.com/o/oauth2/auth

# Encryption key for stored OAuth tokens (generate with:
#   uv run --directory backend python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ROSALIND_TOKEN_ENCRYPTION_KEY=

# Keycloak (identity provider; docker-compose)
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak
KEYCLOAK_DB_NAME=keycloak
ROSALIND_KEYCLOAK_URL=http://localhost:8080
ROSALIND_KEYCLOAK_REALM=rosalind
ROSALIND_KEYCLOAK_AUDIENCE=rosalind
ROSALIND_KEYCLOAK_CLIENT_ID=rosalind-cli

# Bearer-token auth (set to false only for local dev / e2e without Keycloak)
ROSALIND_AUTH_ENABLED=true

# MCP server transport (stdio, sse, or streamable-http)
ROSALIND_MCP_TRANSPORT=streamable-http
ROSALIND_MCP_HOST=127.0.0.1
ROSALIND_MCP_PORT=8000

# Embeddings (BGE-M3). Local inference runs in-process via FlagEmbedding on MPS;
# set ROSALIND_EMBEDDER_BACKEND=tei + ROSALIND_EMBEDDER_URL for a remote server.
ROSALIND_EMBEDDER_BACKEND=flagembedding
ROSALIND_EMBEDDER_DEVICE=auto
ROSALIND_EMBEDDER_USE_FP16=false
ROSALIND_EMBEDDER_BATCH_SIZE=8
ROSALIND_EMBEDDER_MAX_LENGTH=512

# Reranking (bge-reranker-v2-m3). Opt-in: set ROSALIND_SEARCH_RERANKER to enable.
# Runs in-process via FlagEmbedding on MPS; set *_BACKEND=tei + *_URL for remote.
ROSALIND_SEARCH_RERANKER=
ROSALIND_SEARCH_RERANKER_BACKEND=flagembedding
ROSALIND_SEARCH_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
ROSALIND_SEARCH_RERANKER_DEVICE=auto
ROSALIND_SEARCH_RERANKER_USE_FP16=false

# Evaluation (search benchmarking). Dev-only: enables the /eval routes and the
# eval adapters, which use the optional `eval` dependency group. Never enable
# in production. Runs are written under ROSALIND_EVAL__RUNS_DIR.
ROSALIND_EVAL__ENABLED=true
ROSALIND_EVAL__RUNS_DIR=runs
