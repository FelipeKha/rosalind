# Example Rosalind configuration.
#
# Point ROSALIND_CONFIG at a file like this (default: rosalind.yaml).
# Environment variables still override these values, e.g. ROSALIND_DATABASE_URL,
# or ROSALIND_EVAL__ENABLED for the nested eval settings.

database_url: postgresql+psycopg://rosalind:rosalind@localhost:5432/rosalind

log_level: INFO
log_format: console

# Evaluation subsystem (search benchmarking). Dev-only: enable it in the local
# `.env` (ROSALIND_EVAL__ENABLED=true), never in production. Disabled by default;
# when disabled the /eval routes do not exist and production never imports the
# eval code.
eval:
  enabled: false
  runs_dir: runs

# Policy service. Models are an allowlist of local Ollama endpoints only.
# The CLI selects one per request with `--model`; the runtime keeps one model
# resident at a time.
policy:
  enabled: true
  default_model: qwen3.5-9b
  enforcement_live: false
  draft_ttl_seconds: 3600
  models:
    - name: qwen3.5-9b
      provider: ollama
      model: qwen3.5:9b
      base_url: http://127.0.0.1:11434
      quantization: Q4_K_M
      context_window: 8192
    - name: gemma4-e4b
      provider: ollama
      model: gemma4:e4b
      base_url: http://127.0.0.1:11434
      quantization: Q4_K_M
      context_window: 8192
