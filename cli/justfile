# List available recipes
default:
    @just --list

# Format Python code
format:
    uv run ruff format .

# Check formatting and linting
lint:
    uv run ruff format --check .
    uv run ruff check .

# Run static type checking
typecheck:
    uv run mypy .

# Run tests
test:
    uv run pytest

# Run Python security checks
security:
    uv run bandit -r src
    uv run pip-audit

# Run all Python quality checks
check: lint typecheck test security

# Run the CLI
run *ARGS:
    uv run rosalind {{ARGS}}

# Run the complete CI-quality suite
ci: check